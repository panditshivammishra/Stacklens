# Copy this to .env and fill in your values

# PostgreSQL (Docker local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stacklens

# Redis (Docker local)
REDIS_URL=redis://localhost:6379

# Qdrant (Docker local)
QDRANT_URL=http://localhost:6333

# Gemini AI (get free key from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-LLM agent failover chain — comma-separated "provider:model" entries,
# tried in order. Set OPENAI_BASE_URL to use Groq (free) or a local Ollama.
AGENT_MODELS=gemini:gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Legacy Node backend (being retired)
PORT=4000
NODE_ENV=development

# Python backend (FastAPI)
PY_PORT=4001

# ─── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie. Anyone holding this can mint a token for any user,
# so generate a real one for anything but local dev:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_HOURS=168

# The dashboard's exact origin. Cookies are forbidden with a wildcard CORS
# origin, so this cannot be "*".
DASHBOARD_ORIGIN=http://localhost:3000

# true in production (requires HTTPS); false for local dev
COOKIE_SECURE=false
